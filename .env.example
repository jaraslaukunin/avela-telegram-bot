BOT_TOKEN=your_telegram_bot_token

# Режим работы бота:
#   false — polling (локальная разработка, webhook удаляется при старте);
#   true  — webhook (production, Nginx проксирует на этот сервис).
WEBHOOK_MODE=false

# Только для WEBHOOK_MODE=true:
WEBHOOK_SECRET=random_long_secret_string
WEBHOOK_BASE_URL=https://bot.avela.jaraslau.dev

# HTTP API (FastAPI + uvicorn)
API_HOST=127.0.0.1
API_PORT=8000

# База данных. Локально: docker compose -f docker-compose.dev.yml up -d db
DATABASE_URL=postgresql+asyncpg://avela:avela@localhost:5432/avela

# Для интеграционных тестов (та же локальная БД)
TEST_DATABASE_URL=postgresql+asyncpg://avela:avela@localhost:5432/avela

# JWT-сессия Avela (минимум 32 символа; в production — свой секрет!)
JWT_SECRET=dev-only-secret-change-me-0123456789
JWT_TTL_SECONDS=604800

# Supabase (production БД и Storage)
SUPABASE_URL=https://nctnayzkbcgobanxyabv.supabase.co
# Service role key — ТОЛЬКО серверным компонентам, никогда во frontend!
SUPABASE_SERVICE_ROLE_KEY=
# Production БД: строка из дашборда Supabase → Connect → Session pooler
# (проверенный хост пулера: aws-0-eu-west-2.pooler.supabase.com)
# DATABASE_URL=postgresql+asyncpg://postgres.nctnayzkbcgobanxyabv:ПАРОЛЬ@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
